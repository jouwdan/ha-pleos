{
  "title": "Pleos Vehicle Data",
  "config": {
    "step": {
      "user": {
        "title": "Connect your vehicles",
        "description": "Get a **personal** API key from [Pleos Playground]({pleos_url}) → account menu → **My Vehicle Data API** → select manufacturer → **Get API Key** → sign into your manufacturer account. [Step-by-step guide]({key_guide_url}).\n\nSelect the same manufacturer below and paste both credentials. Keys must be replaced manually when they expire; check the expiry shown in Pleos. Only data shared by your vehicle will appear.",
        "data": {
          "brand": "Manufacturer",
          "client_id": "Client ID",
          "client_secret": "Client Secret"
        },
        "data_description": {
          "client_id": "Copy the Client ID from My Vehicle Data API in Pleos Playground.",
          "client_secret": "Copy the matching Client Secret. Home Assistant saves it in its private configuration."
        }
      },
      "reauth_confirm": {
        "title": "Replace your {brand} API key",
        "description": "Generate a new {brand} personal API key in [Pleos Playground]({pleos_url}) → My Vehicle Data API, then paste both new fields below. Personal keys require manual renewal when they expire. Your existing devices and entity IDs will be kept for the same cars.",
        "data": {
          "client_id": "Client ID",
          "client_secret": "Client Secret"
        },
        "data_description": {
          "client_id": "Copy the Client ID from My Vehicle Data API in Pleos Playground.",
          "client_secret": "Copy the matching Client Secret. Home Assistant saves it in its private configuration."
        }
      },
      "reconfigure": {
        "title": "Update your {brand} API key",
        "description": "Generate a new {brand} personal API key in [Pleos Playground]({pleos_url}) → My Vehicle Data API, then paste both new fields below. Personal keys require manual renewal when they expire. Your existing devices and entity IDs will be kept for the same cars.",
        "data": {
          "client_id": "Client ID",
          "client_secret": "Client Secret"
        },
        "data_description": {
          "client_id": "Copy the Client ID from My Vehicle Data API in Pleos Playground.",
          "client_secret": "Copy the matching Client Secret. Home Assistant saves it in its private configuration."
        }
      }
    },
    "error": {
      "invalid_auth": "The API key was rejected. Generate a new personal key and enter both matching fields for this manufacturer.",
      "cannot_connect": "Could not read your vehicles from Pleos. Check your internet connection and personal API availability, then try again.",
      "rate_limited": "Pleos is limiting requests. Wait a few minutes before trying again."
    },
    "abort": {
      "already_configured": "This API key is already configured. Use Reconfigure on its existing entry to replace it."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Vehicle data options",
        "description": "Options reload this integration automatically.",
        "sections": {
          "polling": {
            "name": "Vehicle status",
            "description": "More frequent polling does not make the car upload sooner. Valid last-reported values stay visible while the car is parked.",
            "data": {
              "poll_minutes": "Polling interval",
              "stale_minutes": "Stale-data threshold",
              "location": "Enable location data and GPS tracking",
              "odometer_km_vehicles": "Correct odometer kilometres labelled as miles",
              "reverse_geocode": "Reverse geocode vehicle location",
              "geocoder_url": "Reverse geocoding service URL",
              "geocoder_key": "Reverse geocoding API key / token"
            },
            "data_description": {
              "poll_minutes": "How often status data is requested from Pleos. Trip data has its own interval under Trips.",
              "stale_minutes": "Older readings are marked with data_stale; they do not become unavailable.",
              "location": "Queries the location endpoint and exposes its data. A map tracker is created only for valid WGS84 coordinates.",
              "odometer_km_vehicles": "Select only cars whose API odometer value is in kilometres but labelled miles. Home Assistant will then convert it to your preferred display unit. Leave empty for correctly reported units. This affects new readings only; existing history and statistics are not repaired. Clear the selection if Pleos fixes the underlying data.",
              "reverse_geocode": "Send valid GPS coordinates to your chosen service to resolve an address. Requires location data and a Nominatim-compatible service URL. Off by default.",
              "geocoder_url": "Base URL or /reverse endpoint. Use a URL without login details, query parameters or fragments; redirects are not followed. No service is configured by default.",
              "geocoder_key": "Optional provider API key or access token. For compatible Nominatim-style services it is sent as the key parameter. The credential is sent only to the configured geocoding service and is redacted from diagnostics."
            }
          },
          "trips": {
            "name": "Trips",
            "data": {
              "trip_poll_minutes": "Trip data interval",
              "trip_events": "Fire an event for each new trip"
            },
            "data_description": {
              "trip_poll_minutes": "How often the four trip endpoints are queried. Pleos delivers trip data with a delay, so this can be longer than the polling interval. Trip readings are kept between queries.",
              "trip_events": "Off by default. Fires pleos_vehicle_data_trip once per trip with every sample the API returned. Large trips can be excluded from the recorder. The Trip event entity records every trip regardless of this option."
            }
          },
          "storage": {
            "name": "Storage",
            "data": {
              "archive": "Archive raw vehicle data"
            },
            "data_description": {
              "archive": "Off by default. Keeps raw snapshot payloads and trip objects in compressed files under pleos_vehicle_data/archive in your configuration folder. Unchanged responses are not written again, each trip is stored once, and nothing is deleted."
            }
          }
        }
      }
    }
  },
